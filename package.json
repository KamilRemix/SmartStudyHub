{
  "name": "smartstudyhub",
  "version": "1.0.0",
  "description": "SmartStudyHub - Universal AI Study Companion & Productivity Suite",
  "author": "KamilRemix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:web": "node build-web.js"
  },
  "build": {
    "appId": "com.kamil.smartstudy",
    "productName": "SmartStudyHub",
    "nodeGypRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
