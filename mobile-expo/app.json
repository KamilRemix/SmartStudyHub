{
  "expo": {
    "name": "SmartStudyHub",
    "slug": "smartstudyhub",
    "scheme": "smartstudyhub",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#121212"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#007aff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartstudyhub.mobile"
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.smartstudyhub.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007aff",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6a0421ee-f680-4633-ac7f-69b009867ceb"
      }
    }
  }
}
